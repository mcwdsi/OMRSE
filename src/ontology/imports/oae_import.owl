# Annotation Property: obo:OAE_0004334 (has_MedDRA_id)

AnnotationAssertion(rdfs:label obo:OAE_0004334 "has_MedDRA_id"@en)



############################
#   Classes
############################

# Class: obo:OAE_0000002 (medical intervention)

AnnotationAssertion(obo:IAO_0000115 obo:OAE_0000002 "medical intervention is a planned process that has the goal of diagnosing, preventing or relieving illness or injury.")
AnnotationAssertion(obo:IAO_0000116 obo:OAE_0000002 "The act of intervening, interfering or interceding with the intent of modifying the outcome. In medicine, an intervention is usually undertaken to help treat or cure a condition. For example, \"Acupuncture as a therapeutic intervention is widely practiced in the United States,\" 
Reference:
http://www.medterms.com/script/main/art.asp?articlekey=34214 . Some interventions can be used for diagnosis. ")
AnnotationAssertion(obo:IAO_0000117 obo:OAE_0000002 "YH")
AnnotationAssertion(obo:IAO_0000119 obo:OAE_0000002 "WEB: http://wiki.answers.com/Q/What_is_medical_intervention")
AnnotationAssertion(rdfs:label obo:OAE_0000002 "medical intervention")

# Class: obo:OAE_0000067 (surgery)

AnnotationAssertion(obo:IAO_0000115 obo:OAE_0000067 "Surgery is a medical procedure that uses operative manual and instrumental techniques on a patient to investigate and/or treat a pathological condition such as disease or injury, to help improve bodily function or appearance. The key difference between a surgery and a general procedure is the need for an incision. Making an incision, or cutting into the skin to gain access to the body’s deeper tissues or organs, is a defining characteristic of surgery.")
AnnotationAssertion(obo:IAO_0000117 obo:OAE_0000067 "YH, SS")
AnnotationAssertion(obo:IAO_0000118 obo:OAE_0000067 "surgical procedure")
AnnotationAssertion(obo:IAO_0000119 obo:OAE_0000067 "WEB: http://en.wikipedia.org/wiki/Surgery")
AnnotationAssertion(obo:IAO_0000119 obo:OAE_0000067 "WEB: http://www.wisegeekhealth.com/what-is-the-difference-between-a-surgery-and-a-procedure.htm")
AnnotationAssertion(obo:OAE_0004334 obo:OAE_0000067 "10042609")
AnnotationAssertion(rdfs:label obo:OAE_0000067 "surgery")
SubClassOf(obo:OAE_0000067 obo:OAE_0002807)

# Class: obo:OAE_0002807 (medical procedure)

AnnotationAssertion(obo:IAO_0000115 obo:OAE_0002807 "a medical intervention that refers to any series of pre-defined steps that should be followed to achieve a desired result.")
AnnotationAssertion(obo:IAO_0000117 obo:OAE_0002807 "YH, SS")
AnnotationAssertion(obo:IAO_0000119 obo:OAE_0002807 "WEB: http://www.wisegeekhealth.com/what-is-the-difference-between-a-surgery-and-a-procedure.htm")
AnnotationAssertion(rdfs:label obo:OAE_0002807 "medical procedure"@en)
SubClassOf(obo:OAE_0002807 obo:OAE_0000002)


