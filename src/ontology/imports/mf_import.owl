Ontology(<http://purl.obolibrary.org/obo/omrse/imports/mf_import.owl>
<http://purl.obolibrary.org/obo/omrse/releases/2026-06-20/imports/mf_import.owl>
Annotation(zdc:source <http://purl.obolibrary.org/obo/MF/2025-07-08/MF.owl>)
Annotation(owl:versionInfo "2026-06-20")

Declaration(Class(obo:BFO_0000020))
Declaration(Class(obo:MF_0000030))
Declaration(Class(obo:MF_0000031))
