Declaration(AnnotationProperty(obo:IAO_0000119))
Declaration(AnnotationProperty(zdc:source))


############################
#   Classes
############################

# Class: obo:MF_0000030 (representation)

AnnotationAssertion(obo:IAO_0000115 obo:MF_0000030 "A dependent continuant which is about a portion of reality.")
AnnotationAssertion(obo:IAO_0000119 obo:MF_0000030 "http://www.jbiomedsem.com/content/1/1/10")
AnnotationAssertion(rdfs:label obo:MF_0000030 "representation")
SubClassOf(obo:MF_0000030 obo:BFO_0000020)

# Class: obo:MF_0000031 (cognitive representation)

AnnotationAssertion(obo:IAO_0000115 obo:MF_0000031 "A representation which specifically depends on an anatomical structure in the cognitive system of an organism.")
AnnotationAssertion(obo:IAO_0000119 obo:MF_0000031 "http://www.jbiomedsem.com/content/1/1/10")
AnnotationAssertion(rdfs:label obo:MF_0000031 "cognitive representation")
SubClassOf(obo:MF_0000031 obo:MF_0000030)


