############################
#   Annotation Properties
############################

# Annotation Property: obo:OOSTT_00000030 (OOSTT user-centered description)

AnnotationAssertion(obo:IAO_0000115 obo:OOSTT_00000030 "A description of an OOSTT class that is aimed at the OOSTT user community and not meant to be definition for use in ontology development, curation or maintenance."@en)
AnnotationAssertion(obo:IAO_0000117 obo:OOSTT_00000030 "Mathias Brochhausen"@en)
AnnotationAssertion(rdfs:label obo:OOSTT_00000030 "OOSTT user-centered description"@en)



############################
#   Classes
############################

# Class: obo:OOSTT_00000074 (academic degree)

AnnotationAssertion(obo:IAO_0000115 obo:OOSTT_00000074 "An information content entity that is the specified outcome of and documents the sucessful completion of a tertiary education program."@en)
AnnotationAssertion(obo:IAO_0000117 obo:OOSTT_00000074 "John Judkins"@en)
AnnotationAssertion(obo:IAO_0000117 obo:OOSTT_00000074 "Mathias Brochhausen"@en)
AnnotationAssertion(obo:OOSTT_00000030 obo:OOSTT_00000074 "Recognized degree awarded after successful completion of a college or post-graduate porgram."@en)
AnnotationAssertion(rdfs:label obo:OOSTT_00000074 "academic degree"@en)
SubClassOf(obo:OOSTT_00000074 obo:IAO_0000030)

# Class: obo:OOSTT_00000081 (associate degree)

AnnotationAssertion(obo:IAO_0000115 obo:OOSTT_00000081 "An academic degree awarded by colleges and universities upon completion of a program of study lasting two years."@en)
AnnotationAssertion(obo:IAO_0000117 obo:OOSTT_00000081 "John Judkins"@en)
AnnotationAssertion(obo:IAO_0000117 obo:OOSTT_00000081 "Mathias Brochhausen"@en)
AnnotationAssertion(obo:IAO_0000119 obo:OOSTT_00000081 "https://en.wikipedia.org/w/index.php?title=Associate_degree&oldid=723897149"@en)
AnnotationAssertion(obo:OOSTT_00000030 obo:OOSTT_00000081 "Recognition awarded after completion of a specific curriculum from an accredited tertiary education provider that falls between high school and bachelor's degree program."@en)
AnnotationAssertion(rdfs:label obo:OOSTT_00000081 "associate degree"@en)
SubClassOf(obo:OOSTT_00000081 obo:OOSTT_00000074)

# Class: obo:OOSTT_00000082 (master's degree)

AnnotationAssertion(obo:IAO_0000115 obo:OOSTT_00000082 "An academic degree awarded by universities upon completion of a course of study demonstrating a mastery or high-order overview of a specific field of study or area of professional practice.[1] Within the area studied, graduates are posited to possess advanced knowledge of a specialized body of theoretical and applied topics; high order skills in analysis, critical evaluation, or professional application; and the ability to solve complex problems and think rigorously and independently."@en)
AnnotationAssertion(obo:IAO_0000117 obo:OOSTT_00000082 "John Judkins"@en)
AnnotationAssertion(obo:IAO_0000117 obo:OOSTT_00000082 "Mathias Brochhausen"@en)
AnnotationAssertion(obo:IAO_0000119 obo:OOSTT_00000082 "https://en.wikipedia.org/w/index.php?title=Master%27s_degree&oldid=726036185"@en)
AnnotationAssertion(rdfs:label obo:OOSTT_00000082 "master's degree"@en)
SubClassOf(obo:OOSTT_00000082 obo:OOSTT_00000074)

# Class: obo:OOSTT_00000083 (bachelor's degree)

AnnotationAssertion(obo:IAO_0000115 obo:OOSTT_00000083 "An academic degree awarded by colleges and universities upon completion of a course of study lasting three to seven years."@en)
AnnotationAssertion(obo:IAO_0000117 obo:OOSTT_00000083 "John Judkins"@en)
AnnotationAssertion(obo:IAO_0000117 obo:OOSTT_00000083 "Mathias Brochhausen"@en)
AnnotationAssertion(obo:IAO_0000119 obo:OOSTT_00000083 "https://en.wikipedia.org/w/index.php?title=Bachelor%27s_degree&oldid=725713923"@en)
AnnotationAssertion(rdfs:label obo:OOSTT_00000083 "bachelor's degree"@en)
SubClassOf(obo:OOSTT_00000083 obo:OOSTT_00000074)

# Class: obo:OOSTT_00000084 (bachelor's of nursing degree)

AnnotationAssertion(obo:IAO_0000115 obo:OOSTT_00000084 "An academic degree in the science and principles of nursing, granted by an accredited tertiary education provider after the successful completion of a bachelor's of nursing program."@en)
AnnotationAssertion(obo:IAO_0000117 obo:OOSTT_00000084 "John Judkins"@en)
AnnotationAssertion(obo:IAO_0000117 obo:OOSTT_00000084 "Mathias Brochhausen"@en)
AnnotationAssertion(obo:IAO_0000119 obo:OOSTT_00000084 "https://en.wikipedia.org/w/index.php?title=Bachelor_of_Science_in_Nursing&oldid=725962822"@en)
AnnotationAssertion(rdfs:label obo:OOSTT_00000084 "bachelor's of nursing degree"@en)
SubClassOf(obo:OOSTT_00000084 obo:OOSTT_00000083)

# Class: obo:OOSTT_00000086 (master's in the science of nursing degree)

AnnotationAssertion(obo:IAO_0000115 obo:OOSTT_00000086 "An academic degree in the science and principles of nursing, granted by an accredited tertiary education provider after the successful completion of a master's of nursing program."@en)
AnnotationAssertion(obo:IAO_0000117 obo:OOSTT_00000086 "John Judkins"@en)
AnnotationAssertion(obo:IAO_0000117 obo:OOSTT_00000086 "Mathias Brochhausen"@en)
AnnotationAssertion(obo:OOSTT_00000030 obo:OOSTT_00000086 "An advanced academic degree in the principles and practices of nursing, with a focus on administration, education, or advanced nursing practice, granted by an accredited college or university after the successful completion of a master's of nursing program."@en)
AnnotationAssertion(rdfs:label obo:OOSTT_00000086 "master's in the science of nursing degree"@en)
SubClassOf(obo:OOSTT_00000086 obo:OOSTT_00000082)


)